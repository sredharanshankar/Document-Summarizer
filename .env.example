# ── Backend (FastAPI) ─────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values. Never commit .env.

# AI provider (https://console.groq.com — free tier available)
# Leave AI_API_KEY blank to run in fallback mode: the app still works end
# to end using a rule-based extractive summarizer instead of an LLM.
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_PROVIDER=groq
AI_REQUEST_TIMEOUT_SECONDS=30

# OCR
OCR_ENABLED=true
# Only needed on Windows if Tesseract isn't on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Uploads
MAX_FILE_SIZE=10485760

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOW_ORIGINS=http://localhost:5173

ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Frontend (Vite) ───────────────────────────────────────────────
# Copy the VITE_ vars below into frontend/.env
# Leave blank in development to use Vite's dev proxy (see vite.config.ts).
VITE_API_BASE_URL=
